  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. \u03A4\u03BF\u03C0\u03BF\u03B8\u03AD\u03C4\u03B7\u03C3\u03B7 \u039C\u03BD\u03B7\u03BC\u03B5\u03AF\u03BF\u03C5 (AR Placement)\n\u0392\u03AE\u03BC\u03B1 1: \u03A3\u03C4\u03B1\u03B8\u03B5\u03AF\u03C4\u03B5 \u03BC\u03C0\u03C1\u03BF\u03C3\u03C4\u03AC \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03C7\u03CE\u03C1\u03BF \u03C4\u03BF\u03C5 \u03A1\u03C9\u03BC\u03B1\u03CA\u03BA\u03BF\u03CD \u03A3\u03C4\u03B1\u03B4\u03AF\u03BF\u03C5.\n\n\u0392\u03AE\u03BC\u03B1 2: \u03A3\u03C4\u03C1\u03AD\u03C8\u03C4\u03B5 \u03C4\u03B7\u03BD \u03BA\u03AC\u03BC\u03B5\u03C1\u03B1 \u03C4\u03B7\u03C2 \u03C3\u03C5\u03C3\u03BA\u03B5\u03C5\u03AE\u03C2 \u03C3\u03C4\u03BF \u03AD\u03B4\u03B1\u03C6\u03BF\u03C2 \u03BA\u03B1\u03B9 \u03BC\u03B5\u03C4\u03B1\u03BA\u03B9\u03BD\u03AE\u03C3\u03C4\u03B5 \u03C4\u03B7 \u03B5\u03BB\u03B1\u03C6\u03C1\u03AC \u03BC\u03AD\u03C7\u03C1\u03B9 \u03BD\u03B1 \u03B5\u03BD\u03C4\u03BF\u03C0\u03B9\u03C3\u03C4\u03B5\u03AF \u03B7 \u03B5\u03C0\u03B9\u03C6\u03AC\u03BD\u03B5\u03B9\u03B1 (\u03B5\u03BC\u03C6\u03AC\u03BD\u03B9\u03C3\u03B7 AR \u03C0\u03BB\u03AD\u03B3\u03BC\u03B1\u03C4\u03BF\u03C2).\n\n\u0392\u03AE\u03BC\u03B1 3: \u03A0\u03B1\u03C4\u03AE\u03C3\u03C4\u03B5 (tap) \u03C0\u03AC\u03BD\u03C9 \u03C3\u03C4\u03B7\u03BD \u03B5\u03BD\u03C4\u03BF\u03C0\u03B9\u03C3\u03BC\u03AD\u03BD\u03B7 \u03B5\u03C0\u03B9\u03C6\u03AC\u03BD\u03B5\u03B9\u03B1 \u03B3\u03B9\u03B1 \u03BD\u03B1 \u03B5\u03BC\u03C6\u03B1\u03BD\u03B9\u03C3\u03C4\u03B5\u03AF \u03C4\u03BF 3D \u03BC\u03BF\u03BD\u03C4\u03AD\u03BB\u03BF \u03C4\u03BF\u03C5 \u03C3\u03C4\u03B1\u03B4\u03AF\u03BF\u03C5."
